# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Database Connection
# Leave empty to run in zero-config Demo Mode with preloaded realistic records
MONGODB_URI=

# OpenAI API Key for real GPT-4o inference
# If omitted or left empty, SlidePilot activates its built-in Intelligent Engine
OPENAI_API_KEY=

# n8n Automation Webhook URL (Optional)
# If provided, SlidePilot will dispatch event webhooks to your n8n workflow
N8N_WEBHOOK_URL=

# Explicit demo mode override (true/false)
DEMO_MODE=true

